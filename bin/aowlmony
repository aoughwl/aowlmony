#!/usr/bin/env node
// aowlmony — the nimony rewrite driver over the aoughwl self-owned stack.
//
//   .nim ──► aowlparser (ours) ──► nimony sem + hexer (reused) ──► .s.aif / .c.aif
//                                                                    │        │
//                                              aowli (ours, interpret)┘        └─ aowlc (ours, native C → gcc)
//
// The user's own module(s) are parsed by OUR aowlparser; the standard library is
// parsed by the real nifler (it uses `concept`/typed-nil forms aowlparser does
// not emit yet — a known aowlparser gap). Semantic analysis and hexer's lowering
// (ARC, closures, exceptions, monomorphisation) are reused from nimony until the
// self-owned aowlsem is finished. Code is then either run natively via aowlc or
// interpreted via aowli — the interpreter is a first-class execution mode, and is
// also the intended compile-time / macro engine (replacing nimony's build-and-
// exec native macro plugins).
//
// Commands:
//   aowlmony run    <file.nim>                      native: whole module → binary → run
//   aowlmony build  <file.nim> [-o BIN]             native: emit a binary at BIN
//   aowlmony exec   <file.nim> --entry NAME [--arg V…]   native: call one proc, print result
//   aowlmony interp <file.nim>                      interpret via aowli (first-class)
//   aowlmony vm     <file.nim>                      interpret via aowli's bytecode VM
//   aowlmony ts     <file.nim> [--faithful] [--run] idiomatic TypeScript via aowlts
//   aowlmony py     <file.nim> [--run]              idiomatic Python via aowlpy
//   aowlmony js     <file.nim> [--faithful] [--run] idiomatic JavaScript via aowljs
//   aowlmony parse  <file.nim>                      show OUR aowlparser .p.aif
//   aowlmony nif    <file.nim>                      compile only; print .s.aif / .c.aif paths
//
// Options: -o/--out, --entry, --arg (repeatable), --engine c|aowlc, --faithful,
//   --run, --keep, -v/--verbose
//
// The ts/py/js commands produce the sem'd .s.aif (same artifact as interp) and
// run the matching idiomatic backend (aowlts/aowljs/aowlpy) to emit source next
// to the .nim (or -o); --run also executes it (node / python3). --faithful
// (ts/js) selects int64-exact emission.
//
// Tool locations resolve from env (AOWLMONY_*), then ./aowlmony.config.json, then
// ~/{nimony,aowlparser,aowli,aowlc} defaults. See `resolveTools()`.
"use strict";
const fs = require("fs");
const os = require("os");
const path = require("path");
const cp = require("child_process");

const HOME = os.homedir();

// ---- shared aoughwl CLI style (mirrors ~/.aowl/bin/aowl) --------------------
const COLOR = !process.env.NO_COLOR && process.env.TERM !== "dumb" &&
  (!!process.env.FORCE_COLOR || process.stdout.isTTY);
const rgb = (r, g, b) => (s) => COLOR ? `\x1b[38;2;${r};${g};${b}m${s}\x1b[0m` : String(s);
const sgr = (a, z = 0) => (s) => COLOR ? `\x1b[${a}m${s}\x1b[${z}m` : String(s);
const C = { bold: sgr(1, 22), dim: sgr(2, 22), teal: rgb(45, 212, 191), violet: rgb(167, 139, 250),
  green: rgb(52, 211, 153), amber: rgb(251, 191, 36), red: rgb(248, 113, 113), cyan: rgb(103, 232, 249), gray: rgb(120, 130, 145) };
const G = { diamond: "◆", ok: "✓", cross: "✗", arrow: "→", bar: "│", gear: "⚙", dot: "●" };

// ---- raw ANSI codes (same palette as C.*), gated on the same COLOR check -----
// Used by the single-line Nim highlighter below, which needs raw open/close
// codes rather than the wrap-a-string C.* helpers. All empty when color is off.
const ANSI = COLOR ? {
  reset: "\x1b[0m",
  red: "\x1b[38;2;248;113;113m",     // keywords
  yellow: "\x1b[38;2;251;191;36m",   // types
  cyan: "\x1b[38;2;103;232;249m",    // strings / chars
  green: "\x1b[38;2;52;211;153m",    // comments
} : { reset: "", red: "", yellow: "", cyan: "", green: "" };

// JS port of the user's Nim highlighter scheme (github.com/thing-king/colors,
// highlighter.nim): a char-by-char scan that splits tokens on whitespace and the
// operators ( ) [ ] { } , . ; : + - * / = < > ! , matches accumulated words
// against keyword/type lists, and colors double-quoted strings, single-quoted
// chars (escape-aware, tolerant of an unterminated literal on an error line) and
// `#` line comments. Returns the line unchanged when color is off. Dependency-free.
const HL_KEYWORDS = new Set(("addr and as asm bind block break case cast concept const continue converter " +
  "defer discard distinct div do elif else end enum except export finally for from func if import in include " +
  "interface is isnot iterator let macro method mixin mod nil not notin object of or out proc ptr raise ref " +
  "return shl shr static template try tuple type using var when while xor yield").split(" "));
const HL_TYPES = new Set(("int float string bool char byte uint int8 int16 int32 int64 uint8 uint16 uint32 " +
  "uint64 float32 float64 seq array void").split(" "));
const HL_DELIM = new Set([..."()[]{},.;:+-*/=<>! \t"]);
function hlNim(line) {
  if (!COLOR) return line;
  let out = "", word = "";
  const flush = () => {
    if (!word) return;
    if (HL_KEYWORDS.has(word)) out += ANSI.red + word + ANSI.reset;
    else if (HL_TYPES.has(word)) out += ANSI.yellow + word + ANSI.reset;
    else out += word;
    word = "";
  };
  for (let i = 0; i < line.length; i++) {
    const ch = line[i];
    if (ch === '"' || ch === "'") {           // string / char literal → cyan
      flush();
      const q = ch; let s = ch; i++;
      while (i < line.length) {
        const c = line[i]; s += c;
        if (c === "\\" && i + 1 < line.length) { s += line[i + 1]; i += 2; continue; }
        i++;
        if (c === q) break;                    // closing quote (unterminated: loop just ends)
      }
      i--;                                     // outer loop re-increments
      out += ANSI.cyan + s + ANSI.reset;
    } else if (ch === "#") {                    // comment → green, to end of line
      flush();
      out += ANSI.green + line.slice(i) + ANSI.reset;
      break;
    } else if (HL_DELIM.has(ch)) {              // delimiter/operator: token boundary
      flush();
      out += ch;
    } else {
      word += ch;
    }
  }
  flush();
  return out;
}

// ---- timing ------------------------------------------------------------------
function fmtDur(ms) { return ms < 1000 ? Math.round(ms) + "ms" : (ms / 1000).toFixed(1) + "s"; }
// A concise dim one-liner after a successful run-ish action, e.g.
//   ✓ interp · compiled 312ms · ran 41ms
function timingLine(label, compileMs, runMs, o) {
  if (o && o.time === false) return;
  const seg = [];
  if (compileMs != null) seg.push("compiled " + fmtDur(compileMs));
  if (runMs != null) seg.push("ran " + fmtDur(runMs));
  if (!seg.length) return;
  console.error("  " + C.green(G.ok) + " " + C.dim(label + " · " + seg.join(" · ")));
}

function firstExisting(cands) { for (const c of cands) if (c && fs.existsSync(c)) return c; return cands[cands.length - 1]; }
// The ecosystem is rebranding nif* → aif* → aowl* (aowl intermediate format),
// and a sibling session may be mid-rename/rebuild (repo dir and binary can even
// disagree, e.g. ~/aifparser/bin/aowlparser). Resolve every tool from all three
// prefixes (newest first) and from nimcache build dirs so the driver keeps
// working throughout the churn.
function allPrefixes(name) {
  return [name.replace(/^nif/, "aowl"), name.replace(/^nif/, "aif"), name]; // aowl → aif → nif
}
function nifparserCandidates() {
  const out = [path.join(__dirname, "..", "vendor", "nifparser")];
  const names = allPrefixes("nifparser"); // aowlparser, aifparser, nifparser
  for (const repo of names) {
    for (const bin of names) out.push(path.join(HOME, repo, "bin", bin));
    const ncDir = path.join(HOME, repo, "nimcache");
    try { for (const d of fs.readdirSync(ncDir)) {
      for (const bin of names) { const c = path.join(ncDir, d, bin); if (fs.existsSync(c)) out.push(c); }
    } } catch (_) {}
  }
  return out;
}
// Candidate paths for a tool that may live under ~/aowlX / ~/aifX / ~/nifX with a
// binary named the same (optionally suffixed, e.g. aowli-interp / aowli-interp).
function repoBin(base, suffix) {
  const out = [];
  for (const repo of allPrefixes(base))
    for (const bin of allPrefixes(base))
      out.push(path.join(HOME, repo, "bin", bin + (suffix || "")));
  return out;
}

// Consult the aowl registry (~/.aowl) — the single source of truth for the active
// PROFILE + resolved component exes. Falls back to {} so the driver still runs
// standalone (no ~/.aowl) exactly as before.
function loadStack() {
  // the manager (aowlup) owns the registry; resolve its script from the repo or
  // the ~/.aowl data-home shim. AOWL_PROFILE (from `+profile`) flows via env.
  const cands = [path.join(HOME, "aowlup", "bin", "aowlup"), path.join(HOME, ".aowl", "bin", "aowl")];
  const aowl = cands.find((p) => fs.existsSync(p));
  if (!aowl) return {};
  const r = cp.spawnSync(process.execPath, [aowl, "config"],
    { encoding: "utf8", env: Object.assign({}, process.env, { NO_COLOR: "1" }) });
  if (r.status !== 0 || !r.stdout) return {};
  try { return JSON.parse(r.stdout); } catch (_) { return {}; }
}

function resolveTools() {
  let cfg = {};
  for (const _n of ["aowlmony.config.json", "aifmony.config.json"]) {  // latter = deprecated alias
    const _p = path.join(process.cwd(), _n);
    if (fs.existsSync(_p)) { try { cfg = JSON.parse(fs.readFileSync(_p, "utf8")); break; } catch (_) {} }
  }
  const st = loadStack(), slots = st.slots || {};
  const reg = (slot) => (slots[slot] && slots[slot].exe) || "";
  // precedence: AOWLMONY_* env → aowlmony.config.json (or deprecated aifmony.config.json) → aowlup registry → probe.
  const pick = (env, key, def) =>
    process.env[env] || process.env[env.replace(/^AOWLMONY_/, "AIFMONY_")] || cfg[key] || def;
  const t = {
    nimony:    pick("AOWLMONY_NIMONY",    "nimony",    firstExisting([path.join(HOME, "nimony/bin/nimony")])),
    niflerReal:pick("AOWLMONY_NIFLER",    "nifler",    firstExisting([path.join(HOME, "nimony/bin/nifler")])),
    // real nimsem — used ONLY as the mechanical `.s.nif → .s.idx.nif` indexer
    // (the `x`/GenerateIdx subcommand walks the sem'd NIF; it does NO semantic
    // analysis) when OUR aowlsem does the actual semchecking. See semShimScript.
    nimsemReal:pick("AOWLMONY_NIMSEM",    "nimsem",    firstExisting([path.join(HOME, "nimony/bin/nimsem")])),
    // OUR semantic checker (aowlsem). Injected via a `nimsem` shim only when the
    // active profile selects the aowlsem variant; see compile().
    // NB: do NOT seed this from reg("sem") — the registry's sem slot holds the
    // ACTIVE variant's exe, which is nimony's own nimsem until the default flips.
    // The registry only overrides below, when slots.sem.variant is aowlsem.
    aowlsem:   pick("AOWLMONY_AOWLSEM",   "aowlsem",   firstExisting([path.join(HOME, "aowlsem/bin/aowlsem")])),
    nifparser: pick("AOWLMONY_NIFPARSER", "nifparser", firstExisting(nifparserCandidates())),
    // OUR quick-fix / diagnostics layer (aowlsuggest). Consulted on a compile
    // failure to surface a fix + the command to apply it; also backs `aowlmony fix`.
    aowlsuggest:pick("AOWLMONY_AOWLSUGGEST","aowlsuggest",reg("suggest") || firstExisting([path.join(HOME, "aowlsuggest/bin/aowlsuggest")])),
    nifiInterp:pick("AOWLMONY_NIFI",      "nifiInterp",reg("interp") || firstExisting(repoBin("nifi", "-interp"))),
    nifiVm:    pick("AOWLMONY_NIFI_VM",   "nifiVm",    reg("vm")     || firstExisting(repoBin("nifi", "-vm"))),
    nifc:      pick("AOWLMONY_NIFC",      "nifc",      reg("native") || firstExisting(repoBin("nifc"))),
    // OUR lowering pass (aowlhexer). Used only when the active profile selects the
    // aowlhexer variant (see below); AOWLMONY_NO_AOWLHEXER=1 forces nimony's hexer.
    aifhexer:  pick("AOWLMONY_HEXER",     "aifhexer",  firstExisting([
                 path.join(HOME, "aowlhexer/bin/aowlhexer"), path.join(HOME, "aifhexer/bin/aifhexer")])),
    // OUR idiomatic-source backends (aowlts/aowljs/aowlpy); registry-resolved,
    // else probed across the aowl/aif/nif prefix family.
    aowlts:    pick("AOWLMONY_AOWLTS",    "aowlts",    reg("ts") || firstExisting(repoBin("nifts"))),
    aowljs:    pick("AOWLMONY_AOWLJS",    "aowljs",    reg("js") || firstExisting(repoBin("nifjs"))),
    aowlpy:    pick("AOWLMONY_AOWLPY",    "aowlpy",    reg("py") || firstExisting(repoBin("nifpy"))),
  };
  // Which stack variant is active for each swappable pass. compile() uses these to
  // decide whether to inject OUR parser/hexer or defer to nimony's nifler/hexer.
  t.profile       = st.profile || "hybrid";
  t.parserVariant = (slots.parser || {}).variant || "aowlparser";
  t.hexerVariant  = (slots.hexer  || {}).variant || "aowlhexer";
  // AOWLMONY_SEM env forces the sem variant (aowlsem|nimsem) for one run,
  // ahead of the aowlup registry — lets you exercise sem=aowlsem before the
  // registry default flips.
  t.semVariant    = process.env.AOWLMONY_SEM || (slots.sem || {}).variant || "nimsem";
  if (t.parserVariant === "aowlparser" && reg("parser")) t.nifparser = process.env.AOWLMONY_NIFPARSER || process.env.AIFMONY_NIFPARSER || cfg.nifparser || reg("parser");
  if (t.hexerVariant === "aowlhexer" && reg("hexer"))    t.aifhexer  = process.env.AOWLMONY_HEXER || process.env.AIFMONY_HEXER || cfg.aifhexer  || reg("hexer");
  return t;
}

function fail(msg) { console.error("  " + C.red(G.cross) + " " + C.red(msg)); process.exit(1); }
function log(o, ...a) { if (o.verbose) console.error("  " + C.dim(G.dot) + " " + C.gray(a.join(" "))); }

// aowli flags forwarded verbatim to the interpreter/VM (interp/vm/eval); the
// tracing family and the hybrid-native family. `--` and everything after it is
// the interpreted program's own argv (aowli's `-- ARG…`).
const AOWLI_PASS = (a) =>
  /^--trace(-full|-profile)?$/.test(a) || /^--trace-depth:/.test(a) ||
  a === "--hybrid" || a === "--build-native" ||
  /^--interpret:/.test(a) || /^--native-src:/.test(a) || /^--native-lib:/.test(a);
function parseArgs(argv) {
  const o = { args: [], _: [], aowli: [], progArgs: [] };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "--") { o.progArgs = argv.slice(i + 1); break; }
    else if (a === "-o" || a === "--out") o.out = argv[++i];
    else if (a === "--entry") o.entry = argv[++i];
    else if (a === "-e") o.eval = argv[++i];
    else if (a === "--arg") o.args.push(argv[++i]);
    else if (a === "--engine") o.engine = argv[++i];
    else if (a === "--faithful") o.faithful = true;
    else if (a === "--run") o.run = true;
    else if (a === "--keep") o.keep = true;
    else if (a === "--time") o.time = true;
    else if (a === "--no-time") o.time = false;
    else if (a === "-v" || a === "--verbose") o.verbose = true;
    else if (AOWLI_PASS(a)) o.aowli.push(a);
    else o._.push(a);
  }
  return o;
}

// The nifler-compatible shim: OUR aowlparser for the user module(s) in
// $NIFRW_USER; the real nifler for the stdlib and the --deps import sidecar.
function shimScript(t) {
  return `#!/usr/bin/env bash
REAL_NIFLER=${JSON.stringify(t.niflerReal)}
NIFPARSER=${JSON.stringify(t.nifparser)}
wants_deps=0; pos=(); infile=""; outfile=""
for a in "$@"; do
  case "$a" in
    --deps) wants_deps=1 ;;
    --portablePaths|-f|--forceRebuild|--deps*) ;;
    p|parse) pos+=("p") ;;
    *.nim) pos+=("$a"); infile="$a" ;;
    *.nif|*.aif) pos+=("$a"); outfile="$a" ;;
    *) pos+=("$a") ;;
  esac
done
real_in="$(readlink -f "$infile" 2>/dev/null)"
is_user=0
IFS=':' read -ra USERS <<< "\${NIFRW_USER:-}"
for u in "\${USERS[@]}"; do [ -n "$u" ] && [ "$(readlink -f "$u" 2>/dev/null)" = "$real_in" ] && is_user=1; done
if [ "$is_user" = 1 ]; then
  # real nifler writes the --deps import sidecar (aowlparser emits none)
  [ "$wants_deps" = 1 ] && "$REAL_NIFLER" "$@" >/dev/null 2>&1
  # aowlparser's [out] positional is a no-op (writes nothing), so emit to stdout
  # and redirect to the output path; that also overwrites nifler's sidecar .p.nif.
  if [ -n "$outfile" ]; then exec "$NIFPARSER" p "$infile" - > "$outfile"; else exec "$NIFPARSER" "\${pos[@]}"; fi
else
  exec "$REAL_NIFLER" "$@"
fi
`;
}

// The nimsem-compatible shim: OUR aowlsem semchecks each single module; the
// real nimsem is reused ONLY as the mechanical `.s.nif → .s.idx.nif` indexer
// (its `x`/GenerateIdx subcommand walks the sem'd NIF, no semantic analysis).
// nimony invokes nimsem as:  --base:B --nimcache:NC m [--isSystem|--isMain] <p.nif>…
// aowlsem's `m` wants:        m <in.p.nif> <out.s.nif> [--base:] [--nimcache:] -p:LIB [--noSystem]
// (out path and search path are explicit for aowlsem; nimsem derives them).
// Cyclic module GROUPS (>1 file in one call) aren't handled by aowlsem yet, so
// those calls fall back to the real nimsem unchanged.
function semShimScript(t, libDir) {
  return `#!/usr/bin/env bash
AOWLSEM=${JSON.stringify(t.aowlsem)}
NIMSEM=${JSON.stringify(t.nimsemReal)}
LIB=${JSON.stringify(libDir)}
DBG="\${AOWLMONY_SEM_DEBUG:-}"
[ -n "$DBG" ] && { echo "=== shim raw argv ($#): $*"; echo "cwd=$(pwd)"; } >> /tmp/shimtrace.log
mode=""; base=""; nc=""; issystem=0; seen_cmd=0; files=()
for a in "$@"; do
  if [ "$seen_cmd" = 0 ]; then
    case "$a" in
      --base:*) base="$a" ;;
      --nimcache:*) nc="$a" ;;
      m) mode=m; seen_cmd=1 ;;
      x) mode=x; seen_cmd=1 ;;
      e|idetools) mode=other; seen_cmd=1 ;;
    esac
  else
    case "$a" in
      --isSystem) issystem=1 ;;
      --isMain) : ;;
      *) files+=("$a") ;;
    esac
  fi
done
# Only a plain single-module 'm' is ours; everything else → real nimsem verbatim.
if [ "$mode" != "m" ] || [ "\${#files[@]}" -ne 1 ]; then
  [ -n "$DBG" ] && echo "aowlsem-shim: defer to nimsem (mode=$mode files=\${#files[@]})" >&2
  exec "$NIMSEM" "$@"
fi
in="\${files[0]}"
out="\${in%.p.nif}.s.nif"
sargs=(m "$in" "$out")
[ -n "$base" ] && sargs+=("$base")
[ -n "$nc" ] && sargs+=("$nc")
sargs+=("-p:$LIB")
[ "$issystem" = 1 ] && sargs+=("--noSystem")
[ -n "$DBG" ] && echo "aowlsem-shim: aowlsem \${sargs[*]}" >&2
if [ -n "$DBG" ]; then
  "$AOWLSEM" "\${sargs[@]}" >>/tmp/shimtrace.log 2>&1; rc=$?
  echo "aowlsem rc=$rc; out exists: $([ -f "$out" ] && wc -c <"$out" || echo NO)" >> /tmp/shimtrace.log
  [ "$rc" -ne 0 ] && exit $rc
else
  "$AOWLSEM" "\${sargs[@]}" || exit $?
fi
# mechanical index sidecar (.s.nif → .s.idx.nif); pure NIF walk, no semantics
exec "$NIMSEM" x "$out"
`;
}

// Run aowlparser → nimony (sem+hexer) and return { dir, mainHash, snif, cnif, pnif }.
// The staging dir is persistent and keyed by the source path so `nimony c`'s
// incremental cache is reused across invocations (only the first run is cold).
// On a build failure, surface the COMPILER's own diagnostics — not nifmake's
// internals. nimony prints `path(line, col) Error: msg` on STDOUT; nifmake writes
// a `FAILURE: <…build.nif>` driver line on STDERR that means nothing to a user.
// We show the real diagnostics (the staged `../../…` path rewritten back to the
// file the user named), drop the driver noise (unless -v), then — if aowlsuggest
// recognizes the mistake — print its guidance + the one command that fixes it.
// Parse cleaned compiler output into structured diagnostics. Two frontends:
//   nimony:      path(line, col) Error: message        (Warning:/Hint: too)
//   aowlparser:  file:line:col: error[code]: message   (+ trailing help:/hint:)
function parseDiagnostics(lines) {
  const diags = [];
  const reNimony = /^\s*(.+?)\((\d+),\s*(\d+)\)\s+(Error|Warning|Hint):\s*(.*)$/;
  const reAowl = /^\s*(.+?):(\d+):(\d+):\s*(error|warning|hint)(?:\[([^\]]+)\])?:\s*(.*)$/;
  const reHelp = /^\s*(help|hint):\s*(.*)$/;
  for (const raw of lines) {
    let m;
    if ((m = reNimony.exec(raw)))
      diags.push({ file: m[1], line: +m[2], col: +m[3], severity: m[4].toLowerCase(), code: null, message: m[5], helps: [] });
    else if ((m = reAowl.exec(raw)))
      diags.push({ file: m[1], line: +m[2], col: +m[3], severity: m[4].toLowerCase(), code: m[5] || null, message: m[6], helps: [] });
    else if (diags.length && (m = reHelp.exec(raw)))
      diags[diags.length - 1].helps.push({ kind: m[1].toLowerCase(), text: m[2] });
  }
  return diags;
}

// Resolve a diagnostic's display path back to a readable source file and return
// its lines, or null if it can't be read (renderer then falls back to one-line).
function readSourceLines(d, abs, nimFile) {
  let p = null;
  if (d.file === nimFile || path.basename(d.file) === path.basename(abs)) p = abs;
  else { const cand = path.resolve(path.dirname(abs), d.file); if (fs.existsSync(cand)) p = cand; else if (fs.existsSync(d.file)) p = d.file; }
  if (!p) return null;
  try { return fs.readFileSync(p, "utf8").split(/\r?\n/); } catch (_) { return null; }
}

// Caret width: endCol if the frontend gave one, else the identifier/word starting
// at col, min 1.
function caretSpan(d, line) {
  if (d.endCol && d.endCol >= d.col) return d.endCol - d.col + 1;
  let n = 0;
  for (let i = d.col - 1; i >= 0 && i < line.length && /[A-Za-z0-9_]/.test(line[i]); i++) n++;
  return Math.max(1, n);
}

// Render one diagnostic as a framed, syntax-highlighted source snippet (rustc
// style): severity-colored header, a dim line-number gutter, one line of context
// above/below when present, a caret underline in the severity color, and any
// help:/hint: notes under a `=` marker. Falls back to a one-liner when the source
// line can't be read.
function renderDiag(d, abs, nimFile) {
  const sevColor = d.severity === "warning" ? C.amber : d.severity === "hint" ? C.cyan : C.red;
  const header = C.bold(sevColor(d.severity)) + (d.code ? C.gray("[" + d.code + "]") : "") + ": " + d.message;
  const srcLines = readSourceLines(d, abs, nimFile);
  const target = d.line - 1;
  if (!srcLines || typeof srcLines[target] !== "string") {
    console.error("  " + sevColor(d.file + ":" + d.line + ":" + d.col + ":") + " " + header);
    for (const h of d.helps) console.error("  " + C.gray("= " + h.kind + ": " + h.text));
    return;
  }
  const lo = Math.max(0, target - 1), hi = Math.min(srcLines.length - 1, target + 1);
  const gw = String(hi + 1).length;
  const pad = (n) => String(n).padStart(gw);
  const rail = " ".repeat(gw) + " " + C.gray(G.bar);
  console.error(header);
  console.error(" ".repeat(gw) + " " + C.gray("┌─ ") + C.gray(d.file + ":" + d.line + ":" + d.col));
  console.error(rail);
  for (let i = lo; i <= hi; i++) {
    if (i === target) {
      console.error(C.dim(pad(i + 1)) + " " + C.gray(G.bar) + " " + hlNim(srcLines[i]));
      const span = caretSpan(d, srcLines[i]);
      console.error(rail + " " + " ".repeat(Math.max(0, d.col - 1)) +
        sevColor("^".repeat(span)) + " " + sevColor(d.message));
    } else {
      console.error(C.dim(pad(i + 1) + " " + G.bar + " " + srcLines[i]));
    }
  }
  for (const h of d.helps) console.error(" ".repeat(gw) + " " + C.gray("= " + h.kind + ": " + h.text));
}

function reportCompileFailure(r, nimFile, abs, stage, o, t) {
  const src = path.resolve(abs);
  let staged = null;
  try { staged = path.relative(stage, src); } catch (_) {}
  const clean = (s) => { if (staged) s = s.split(staged).join(nimFile); return s.split(src).join(nimFile); };
  const isNoise = (s) =>
    /^\s*FAILURE:\s/.test(s) || /\bnifmake\b/.test(s) || /\.build\.nif\b/.test(s) ||
    /\.deps\.nif\b/.test(s) || (stage && s.includes(stage)) || /^\s*[✗×]\s/.test(s);
  const lines = ((r.stdout || "") + "\n" + (r.stderr || ""))
    .split(/\r?\n/).map((s) => s.replace(/\s+$/, "")).filter((s) => s.trim() && !isNoise(s)).map(clean);
  const diags = parseDiagnostics(lines);
  const shownKeys = new Set();
  if (diags.length) {
    let first = true;
    for (const d of diags) {
      if (!first) console.error("");
      first = false;
      renderDiag(d, abs, nimFile);
      shownKeys.add((d.code || "") + "@" + d.line);
    }
  } else {
    // no parseable diagnostic — preserve the old one-line behavior
    const errs = lines.filter((s) => /\bError:/.test(s));
    const show = errs.length ? errs : lines;
    if (show.length) { for (const s of show) console.error("  " + C.red(s)); }
    else { const raw = ((r.stdout || "") + (r.stderr || "")).trim(); if (raw) console.error(clean(raw)); }
  }
  if (o.verbose && r.stderr) { console.error(C.gray("  [verbose] raw driver output:")); process.stderr.write(r.stderr); }
  suggestFixHints(nimFile, abs, t, shownKeys);
}

// Ask aowlsuggest whether it recognizes (and can fix) anything in the file — many
// cryptic sem errors are a habit from another language (function→proc, else if→
// elif, <T>→[T], unterminated string, mismatched bracket…). Print its guidance +
// the exact command to apply the fix. Best-effort: silent if the tool is absent
// or has nothing to say, and never blocks the primary error.
function suggestFixHints(nimFile, abs, t, shownKeys) {
  shownKeys = shownKeys || new Set();
  const bin = t && t.aowlsuggest;
  if (!bin || !fs.existsSync(bin)) return;
  let parsed;
  try {
    const rr = cp.spawnSync(bin, ["check", abs, "--format:json"], { encoding: "utf8" });
    const out = (rr.stdout || "").trim();
    if (!out) return;
    parsed = JSON.parse(out);
  } catch (_) { return; }
  let diags = [];
  if (Array.isArray(parsed)) diags = parsed;
  else if (parsed && Array.isArray(parsed.files)) for (const f of parsed.files) diags.push(...(f.diagnostics || []));
  if (diags.length === 0) return;
  // Dedupe: a finding already shown as the primary diagnostic (same code + line)
  // isn't repeated — but if it's auto-fixable we still surface the apply command.
  let anyFixable = false;
  const fresh = [];
  for (const d of diags) {
    if (d.fix || d.autofixable) anyFixable = true;
    if (shownKeys.has((d.code || "") + "@" + d.line)) continue;
    fresh.push(d);
  }
  if (fresh.length) {
    console.error("");
    console.error("  " + C.cyan("aowlsuggest") + C.gray(" recognizes this — likely a cross-language habit:"));
    for (const d of fresh.slice(0, 6)) {
      const at = d.line ? ":" + d.line + (d.col ? ":" + d.col : "") : "";
      const tip = d.fix ? C.gray("  → " + d.fix) : "";
      console.error("    " + C.amber("•") + " " + C.gray(nimFile + at) + "  " + (d.message || d.code || "") + tip);
    }
    if (fresh.length > 6) console.error("    " + C.gray("… " + (fresh.length - 6) + " more (aowlsuggest lint " + nimFile + ")"));
  }
  if (anyFixable) console.error("  " + C.gray("apply the auto-fixes: ") + C.cyan("aowlmony fix " + nimFile));
}

function compile(nimFile, o, t) {
  if (!fs.existsSync(nimFile)) fail("no such file: " + nimFile);
  const abs = path.resolve(nimFile);
  // Key the persistent stage on the source path AND the active stack variants, so
  // switching profile (parser/hexer/sem) never reuses another profile's cached
  // .p/.s/.c artifacts (nimony's incremental cache would otherwise skip re-parsing).
  const key = require("crypto").createHash("sha1")
    .update([abs, t.parserVariant, t.hexerVariant, t.semVariant].join("\0"))
    .digest("hex").slice(0, 12);
  const stage = o.out && o.keep ? path.join(path.dirname(abs), ".aowlmony")
    : path.join(os.tmpdir(), "aowlmony-cache", key);
  fs.mkdirSync(stage, { recursive: true });
  // parser: inject OUR aowlparser (via the nifler shim) only when the active
  // profile selects the aowlparser variant; otherwise let nimony's own nifler
  // parse everything (the `nimony` profile / `aowl use parser nifler`).
  const useOurParser = (t.parserVariant || "aowlparser") === "aowlparser";
  const shim = path.join(stage, "nifler");
  if (useOurParser) { fs.writeFileSync(shim, shimScript(t)); fs.chmodSync(shim, 0o755); }
  else if (fs.existsSync(shim)) fs.rmSync(shim);
  // Stage a `hexer` shim → aowlhexer so nimony's build (findTool("hexer")) uses
  // OUR lowering pass — only when the profile selects the aowlhexer variant.
  // AOWLMONY_NO_AOWLHEXER=1 forces nimony's hexer regardless.
  const wantAifhexer = (t.hexerVariant || "aowlhexer") === "aowlhexer";
  const useAifhexer = wantAifhexer && t.aifhexer && fs.existsSync(t.aifhexer) && !(process.env.AOWLMONY_NO_AOWLHEXER || process.env.AOWLMONY_NO_AOWLHEXER);
  const hexerShim = path.join(stage, "hexer");
  if (useAifhexer) {
    fs.writeFileSync(hexerShim, "#!/usr/bin/env bash\nexec " + JSON.stringify(t.aifhexer) + " \"$@\"\n");
    fs.chmodSync(hexerShim, 0o755);
  } else if (fs.existsSync(hexerShim)) {
    fs.rmSync(hexerShim);   // ensure a stale shim doesn't linger in the cache
  }
  o._usedAifhexer = useAifhexer;
  // Stage a `nimsem` shim → aowlsem so nimony's build (findTool("nimsem")) uses
  // OUR semantic checker — only when the profile selects the aowlsem variant.
  // AOWLMONY_NO_AOWLSEM=1 forces nimony's nimsem regardless. The shim translates
  // nimsem's `m` argv to aowlsem's, and reuses real nimsem's `x` subcommand as a
  // mechanical indexer (no semantics). See semShimScript.
  const wantAowlsem = (t.semVariant || "nimsem") === "aowlsem";
  const useAowlsem = wantAowlsem && t.aowlsem && fs.existsSync(t.aowlsem) && !process.env.AOWLMONY_NO_AOWLSEM;
  const semShim = path.join(stage, "nimsem");
  if (useAowlsem) {
    const libDir = path.join(path.dirname(path.dirname(t.nimony)), "lib");
    fs.writeFileSync(semShim, semShimScript(t, libDir));
    fs.chmodSync(semShim, 0o755);
  } else if (fs.existsSync(semShim)) {
    fs.rmSync(semShim);   // ensure a stale shim doesn't linger in the cache
  }
  o._usedAowlsem = useAowlsem;
  const nc = path.join(stage, "nc");

  // Content-freshness guard. nifmake's needsRebuild is mtime-only: it rebuilds a
  // node only when a source's mtime is strictly newer than the cached output. A
  // same-second edit, coarse mtime granularity, or an mtime-preserving editor/copy
  // leaves mtime unchanged, so a genuine content change would silently reuse the
  // stale build — even a corrupted file would "run" the previous output. We hash
  // the entry source and, when its content changed since the last build, bump its
  // mtime so nifmake rebuilds the affected chain (the incremental cache for
  // unchanged deps — stdlib etc. — is preserved).
  try {
    const shaPath = path.join(stage, ".entry.sha256");
    const cur = require("crypto").createHash("sha256").update(fs.readFileSync(abs)).digest("hex");
    let prev = "";
    try { prev = fs.readFileSync(shaPath, "utf8").trim(); } catch (_) {}
    if (cur !== prev) {
      try { const now = new Date(); fs.utimesSync(abs, now, now); } catch (_) {}
      try { fs.writeFileSync(shaPath, cur); } catch (_) {}
    }
  } catch (_) {}

  const env = Object.assign({}, process.env, {
    NIFRW_USER: abs,
    PATH: stage + path.delimiter + process.env.PATH,
  });
  log(o, "nifparser parses", path.basename(abs) + ";",
    useAowlsem ? "sem via aowlsem (ours)" : "sem via nimony nimsem;",
    useAifhexer ? "lowering via aowlhexer (ours)" : "lowering via nimony hexer");
  const _t0 = process.hrtime.bigint();
  const r = cp.spawnSync(t.nimony, ["c", "--nimcache:" + nc, abs],
    { cwd: stage, env, encoding: "utf8" });
  const compileMs = Number(process.hrtime.bigint() - _t0) / 1e6;
  if (o.verbose && r.stderr) process.stderr.write(r.stderr);

  // main module: the nc subdir that holds <hash>.c.aif matching its own name
  let mainHash = null, cnif = null;
  if (fs.existsSync(nc)) {
    for (const d of fs.readdirSync(nc)) {
      const sub = path.join(nc, d);
      if (fs.statSync(sub).isDirectory()) {
        const c = path.join(sub, d + ".c.nif");
        if (fs.existsSync(c)) { mainHash = d; cnif = c; break; }
      }
    }
  }
  // Treat the build as failed if it emitted a diagnostic — NOT merely if no
  // .c.nif exists. A failed rebuild leaves the PREVIOUS build's .c.nif in the
  // cache, so a mainHash match alone would silently run stale output (nimony `c`
  // can even exit 0 on failure). `path(line,col) Error:` is nimony's format;
  // `error[code]` is aowlparser's.
  const hadError = r.status !== 0 ||
    /(\bError:|error\[)/.test((r.stdout || "") + "\n" + (r.stderr || ""));
  if (!mainHash || hadError) {
    reportCompileFailure(r, nimFile, abs, stage, o, t);
    fail("compile failed");
  }
  const snif = path.join(nc, mainHash + ".s.nif");
  const pnif = path.join(nc, mainHash + ".p.nif");
  // provenance check: the user module must have been parsed by OUR aowlparser
  let byOurParser = false;
  try { byOurParser = /vendor "(?:nif|aif|aowl)parser"/.test(fs.readFileSync(pnif, "utf8")); } catch (_) {}
  return { stage, nc, mainHash, snif, cnif, pnif, byOurParser, compileMs };
}

function runTool(bin, args, opts = {}) {
  return cp.spawnSync(bin, args, Object.assign({ stdio: "inherit" }, opts));
}

// Build the aowli argv for interp/vm/eval: forwarded aowli flags, then the .s.nif,
// then the program's own args after `--`. `vmOnly` keeps just the VM-supported
// trace flags. Under --hybrid --build-native with no --native-src, auto-supply the
// entry source (we know it) — logged at -v.
function aowliArgs(snif, absSrc, o, vmOnly) {
  let pass = o.aowli.slice();
  if (vmOnly) pass = pass.filter((a) => a === "--trace" || a === "--trace-full");
  else if (pass.includes("--hybrid") && pass.includes("--build-native") &&
           !pass.some((a) => a.startsWith("--native-src:"))) {
    pass.push("--native-src:" + absSrc);
    log(o, "hybrid: auto --native-src:" + absSrc + " (entry source)");
  }
  const args = [...pass, snif];
  if (o.progArgs && o.progArgs.length) args.push("--", ...o.progArgs);
  return args;
}

// Idiomatic-source backends (aowlts/aowljs/aowlpy). Each reads the main
// module's sem'd .s.aif (imported user modules are pulled from the same nc dir
// by the backend itself) and writes emitted source to stdout; we capture it and
// write `outFile`. `--faithful` (ts/js only) selects int64-exact emission.
function emitBackend(bin, snif, outFile, faithful, lang, o, t) {
  if (!bin || !fs.existsSync(bin)) fail(lang + " backend not found (set AOWLMONY_AOWL" +
    lang.toUpperCase() + " or build ~/aowl" + lang + "/bin/aowl" + lang + ")");
  const args = [];
  if (faithful) args.push("--faithful");
  args.push(snif);
  log(o, lang, "backend", path.basename(bin), "emits", path.basename(outFile),
    faithful ? "(faithful)" : "");
  const r = cp.spawnSync(bin, args, { encoding: "utf8" });
  if (r.status !== 0) { process.stderr.write(r.stderr || ""); fail(lang + " backend failed"); }
  fs.writeFileSync(outFile, r.stdout);
  return outFile;
}

// Where to put the emitted source: -o if given, else beside the .nim source.
function outPath(nimFile, o, ext) {
  if (o.out) return path.resolve(o.out);
  const abs = path.resolve(nimFile);
  return path.join(path.dirname(abs), path.basename(abs, path.extname(abs)) + "." + ext);
}

function main() {
  const argv = process.argv.slice(2);
  // `+profile` (rustup-style) = compile with an ephemeral toolchain profile for
  // this one invocation; flows to `aowl config` via AOWL_PROFILE (see loadStack).
  if (argv[0] && argv[0][0] === "+") process.env.AOWL_PROFILE = argv.shift().slice(1);
  const cmd = argv[0];
  const o = parseArgs(argv.slice(1));
  const t = resolveTools();

  if (!cmd || cmd === "-h" || cmd === "--help" || cmd === "help") {
    process.stdout.write("\n  " + C.teal(G.diamond) + " " + C.bold(C.teal("aowlmony")) + "  " +
      C.dim(G.bar) + "  " + C.gray("nimony driver over the self-owned aowl stack") + "\n\n");
    const rows = [
      ["run FILE", "native: compile → binary → run"],
      ["build FILE [-o BIN]", "native: emit a binary"],
      ["exec FILE --entry N", "native: call one proc, print result"],
      ["interp FILE", "interpret via aowli (tree-walk)"],
      ["eval FILE | -e CODE", "run via aowli; -e runs inline code, - reads stdin"],
      ["vm FILE", "interpret via aowli bytecode VM"],
      ["ts|js FILE [--faithful]", "emit idiomatic TypeScript / JavaScript"],
      ["py FILE", "emit idiomatic Python"],
      ["parse FILE", "show OUR .p.nif"],
      ["nif FILE", "compile only; print .s/.c.nif paths"],
      ["fix FILE [--dry-run]", "apply aowlsuggest quick-fixes (cross-language habits)"],
      ["lint FILE", "aowlsuggest diagnostics only (no compile)"],
    ];
    for (const [a, d] of rows) console.log("  " + C.teal(a) + " ".repeat(Math.max(1, 26 - a.length)) + C.gray(d));
    console.log("");
    console.log("  " + C.gray("profile ") + G.arrow + " " + C.bold(C.violet(t.profile)) +
      C.dim("  parser=") + C.cyan(t.parserVariant) + C.dim(" hexer=") + C.cyan(t.hexerVariant) +
      C.dim(" sem=") + C.cyan(t.semVariant) + C.dim("   one-shot: ") + C.teal("aowlmony +nimony run <file>"));
    console.log("  " + C.gray("options ") + G.arrow + " " +
      C.dim("-o  --entry  --arg  --engine  --faithful  --run  --keep  --no-time  -v"));
    console.log("  " + C.gray("aowli   ") + G.arrow + " " +
      C.dim("interp/vm/eval forward --trace[-full|-profile] --trace-depth:N, the hybrid ") +
      C.dim("family (--hybrid --build-native --interpret: --native-src: --native-lib:), and ") + C.teal("-- ARG…") + C.dim(" to the program"));
    console.log("  " + C.gray("toolchain ") + G.arrow + " " + C.teal("aowlup") +
      C.dim("   — aowlup manages the stack (profiles/versions/setup), aowlmony compiles (rustup : cargo)"));
    console.log("");
    return;
  }

  if (t.semVariant === "aowlsem" && !(t.aowlsem && fs.existsSync(t.aowlsem)))
    console.error("  " + C.amber("!") + " " + C.gray("profile selects ") + C.cyan("sem=aowlsem") +
      C.gray(", but the aowlsem binary was not found (build ~/aowlsem/bin/aowlsem or set AOWLMONY_AOWLSEM) — using nimony sem"));

  if (cmd === "parse") {
    const f = o._[0]; if (!f) fail("parse needs a .nim file");
    const r = runTool(t.nifparser, ["p", f, "-"]);   // '-' output → stdout
    process.exit(r.status || 0);
  }

  // aowlsuggest passthrough — quick-fixes & diagnostics over the source, no
  // compile needed. `fix` applies the verified auto-fixes (use --dry-run to
  // preview a diff); `lint`/`check` just report. This is the same layer the
  // compile-failure path consults to suggest a fix + command.
  if (cmd === "fix" || cmd === "lint" || cmd === "check") {
    const f = o._[0]; if (!f) fail(cmd + " needs a .nim file");
    if (!fs.existsSync(f)) fail("no such file: " + f);
    if (!t.aowlsuggest || !fs.existsSync(t.aowlsuggest))
      fail("aowlsuggest not found — build ~/aowlsuggest/bin/aowlsuggest or set AOWLMONY_AOWLSUGGEST");
    const extra = [];
    if (cmd === "fix") extra.push(process.argv.includes("--dry-run") ? "--dry-run" : "--write");
    for (const a of process.argv.slice(2)) if (/^--(format:|style:|pedantic|stats|quiet|color)/.test(a)) extra.push(a);
    const r = runTool(t.aowlsuggest, [cmd, f, ...extra]);
    process.exit(r.status == null ? 0 : r.status);
  }

  // eval: the friendliest "just run it" — a FILE (like interp), inline `-e CODE`,
  // or `-` for stdin. Inline/stdin snippets go to a temp .nim (run as-is; nothing
  // auto-injected) that's cleaned up on exit. Errors flow through the rich renderer.
  let file = o._[0];
  if (cmd === "eval") {
    let code = null;
    if (o.eval != null) code = o.eval;
    else if (o._[0] === "-") { try { code = fs.readFileSync(0, "utf8"); } catch (_) { code = ""; } }
    if (code != null) {
      const tmp = path.join(os.tmpdir(), "aowlmony-eval-" + process.pid + ".nim");
      fs.writeFileSync(tmp, code.endsWith("\n") ? code : code + "\n");
      process.on("exit", () => { try { fs.unlinkSync(tmp); } catch (_) {} });
      file = tmp;
    } else if (!file) fail("eval needs a FILE, -e CODE, or -");
  }
  if (!file) fail(cmd + " needs a .nim file");
  const absSrc = path.resolve(file);
  const b = compile(file, o, t);
  if (o.verbose) log(o, "main module", b.mainHash, "parsed by",
    b.byOurParser ? "nifparser (ours)" : "nifler (fallback)");
  // Time the run/backend step separately from compile() (already timed).
  const timeRun = (fn) => { const s = process.hrtime.bigint(); const r = fn(); return { r, ms: Number(process.hrtime.bigint() - s) / 1e6 }; };

  switch (cmd) {
    case "nif":
      console.log(".p.nif  " + b.pnif + (b.byOurParser ? "  (nifparser)" : "  (nifler)"));
      console.log(".s.nif  " + b.snif);
      console.log(".c.nif  " + b.cnif);
      break;
    case "interp":
    case "eval": {
      const { r, ms } = timeRun(() => runTool(t.nifiInterp, aowliArgs(b.snif, absSrc, o, false)));
      const st = r.status == null ? 0 : r.status;
      if (st === 0) timingLine(cmd, b.compileMs, ms, o);
      process.exit(st);
    }
    case "vm": {
      const { r, ms } = timeRun(() => runTool(t.nifiVm, aowliArgs(b.snif, absSrc, o, true)));
      const st = r.status == null ? 0 : r.status;
      if (st === 0) timingLine(cmd, b.compileMs, ms, o);
      process.exit(st);
    }
    case "exec": {
      if (!o.entry) fail("exec needs --entry NAME");
      const a = ["exec", b.cnif, "--entry", o.entry];
      for (const v of o.args) a.push("--arg", v);
      const { r, ms } = timeRun(() => runTool("node", [t.nifc, ...a]));
      const st = r.status == null ? 0 : r.status;
      if (st === 0) timingLine(cmd, b.compileMs, ms, o);
      process.exit(st);
    }
    case "build": {
      const a = ["build", b.cnif];
      if (o.out) a.push("-o", o.out);
      const { r, ms } = timeRun(() => runTool("node", [t.nifc, ...a]));
      const st = r.status == null ? 0 : r.status;
      if (st === 0) timingLine(cmd, b.compileMs, ms, o);
      process.exit(st);
    }
    case "run": {
      const { r, ms } = timeRun(() => runTool("node", [t.nifc, "run", b.cnif]));
      const st = r.status == null ? 0 : r.status;
      if (st === 0) timingLine(cmd, b.compileMs, ms, o);
      process.exit(st);
    }
    case "ts": {
      const out = emitBackend(t.aowlts, b.snif, outPath(file, o, "ts"), o.faithful, "ts", o, t);
      console.error("  " + C.green(G.ok) + " " + C.gray("wrote ") + C.cyan(out.replace(HOME, "~")));
      if (o.run) {
        const { r, ms } = timeRun(() => runTool("node", ["--experimental-transform-types", "--no-warnings", out]));
        const st = r.status == null ? 0 : r.status;
        if (st === 0) timingLine(cmd, b.compileMs, ms, o);
        process.exit(st);
      }
      timingLine(cmd, b.compileMs, null, o);
      break;
    }
    case "py": {
      const out = emitBackend(t.aowlpy, b.snif, outPath(file, o, "py"), false, "py", o, t);
      console.error("  " + C.green(G.ok) + " " + C.gray("wrote ") + C.cyan(out.replace(HOME, "~")));
      if (o.run) {
        const { r, ms } = timeRun(() => runTool("python3", [out]));
        const st = r.status == null ? 0 : r.status;
        if (st === 0) timingLine(cmd, b.compileMs, ms, o);
        process.exit(st);
      }
      timingLine(cmd, b.compileMs, null, o);
      break;
    }
    case "js": {
      const out = emitBackend(t.aowljs, b.snif, outPath(file, o, "js"), o.faithful, "js", o, t);
      console.error("  " + C.green(G.ok) + " " + C.gray("wrote ") + C.cyan(out.replace(HOME, "~")));
      if (o.run) {
        // aowljs's flush emits a top-level `return __out;`; wrap the module in an
        // IIFE and print its return value (same as aowljs's own run harness).
        const src = fs.readFileSync(out, "utf8");
        const { r, ms } = timeRun(() => runTool("node", ["-e", "process.stdout.write((function(){" + src + "})())"]));
        const st = r.status == null ? 0 : r.status;
        if (st === 0) timingLine(cmd, b.compileMs, ms, o);
        process.exit(st);
      }
      timingLine(cmd, b.compileMs, null, o);
      break;
    }
    default:
      fail("unknown command '" + cmd + "'. Try `aowlmony help`.");
  }
}

try { main(); } catch (e) { fail((e && e.stack) || String(e)); }
